# Copy to .env for local runs. In GitHub Actions these come from repo Secrets.
# .env is gitignored -- never commit real credentials.

# eBay Production keys from https://developer.ebay.com/my/keys
# Use the PRODUCTION App ID / Cert ID, not Sandbox. Sandbox returns no real listings.
EBAY_CLIENT_ID=your-production-app-id
EBAY_CLIENT_SECRET=your-production-cert-id

# ntfy topic. Anyone who knows this string can read AND post to it, so make it
# long and random -- do not use something guessable like "onepiece".
# Generate one with:  python -c "import secrets; print('op-boxes-'+secrets.token_hex(8))"
NTFY_TOPIC=op-boxes-change-me-to-something-random
NTFY_SERVER=https://ntfy.sh

# Alert whenever a product hits a new all-time low, on top of your
# per-product alert_below targets. Set to false for target-only alerts.
ALERT_ON_NEW_LOW=true
